APP_NAME="Tic Hub API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Production: use APP_ENV=production, APP_DEBUG=false, HTTPS URLs, and a generated APP_KEY.

FRONTEND_URL=http://localhost:5173,http://localhost:8443
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8443,127.0.0.1:8443
TRUSTED_PROXIES=127.0.0.1,::1
PUBLIC_TICKET_TRACKING_EXPIRY_DAYS=
PUBLIC_TICKET_TRACKING_KEY=
PUBLIC_TICKET_TRACKING_KEYS=
PUBLIC_TICKET_TRACKING_KEY_VERSION=1
PUBLIC_HISTORY_DRIVER=mail
PUBLIC_HISTORY_OTP_EXPIRY_MINUTES=10
PUBLIC_HISTORY_MAX_ATTEMPTS=5
PUBLIC_HISTORY_RESEND_COOLDOWN_SECONDS=60
PUBLIC_HISTORY_ACCESS_TTL_MINUTES=15
PUBLIC_ACTION_ACCESS_TTL_MINUTES=10
PUBLIC_HISTORY_IDENTITY_KEY=
PUBLIC_HISTORY_OTP_PEPPER=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apg_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=apg_crm_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production: SESSION_SECURE_COOKIE=true. Prefer a same-site frontend/API topology.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
TICKET_ATTACHMENT_DISK=local
# Staging may isolate these roots outside the shared application storage tree.
# TICKET_ATTACHMENT_ROOT=/srv/crm/private-ticket-attachments
# PUBLIC_STORAGE_ROOT=/srv/crm/legacy-public-storage
QUEUE_CONNECTION=database

# Production requires one scheduler invocation per minute. Workers are optional until queued jobs are enabled.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Production public-history OTP delivery requires a real mailer; log and array are rejected.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# One-time testing/staging user provisioning only. Supply through a protected environment at command execution.
# TIC_HUB_BOOTSTRAP_PASSWORD=

# Production-only initial super admin bootstrap (`php artisan users:bootstrap-production`).
# Optional: if unset, the command generates a one-time password and prints it exactly once.
# TIC_HUB_ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
TINYMCE_API_KEY=

# Dynamic Workflow Engine (Tahap 7)
# Default: false. Only set to true AFTER running `php artisan crm:workflow-check`
# and verifying an active published workflow exists in a safe environment.
CRM_DYNAMIC_WORKFLOW_ENABLED=false

WHATSAPP_PROVIDER=fonnte
WHATSAPP_NOTIFICATION_ENABLED=false
WHATSAPP_EVENT_TICKET_CREATED=false
WHATSAPP_EVENT_TICKET_ASSIGNED=false
WHATSAPP_EVENT_IMPORTANT_STATUS_CHANGED=false
WHATSAPP_EVENT_SLA_WARNING=false
WHATSAPP_EVENT_SLA_BREACHED=false
WHATSAPP_EVENT_TICKET_COMPLETED=false
WHATSAPP_RECIPIENT_TICKET_CREATED_IT_SUPPORT=false
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_TOKEN=
FONNTE_COUNTRY_CODE=62
FONNTE_CONNECT_ONLY=true
FONNTE_TIMEOUT=15
FONNTE_RETRY_TIMES=1
FONNTE_IT_SUPPORT_NUMBER=
FONNTE_WEBHOOK_SECRET=
